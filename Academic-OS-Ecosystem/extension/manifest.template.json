{
  "manifest_version": 3,
  "name": "Academic OS – DSP BITS Tracker",
  "version": "3.0.0",
  "description": "Track DSP-BITS progress and see a placement estimate built from your BITS Lumen course activity.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Academic OS",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["identity"],
  "host_permissions": ["__API_ORIGIN_PATTERN__"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
