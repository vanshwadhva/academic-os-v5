# Copy to .env locally. Never commit the populated .env file.
# Use a hex password so it is safe to embed in the Compose DATABASE_URL.
POSTGRES_USER=academic_os
POSTGRES_PASSWORD=
POSTGRES_DB=placement_db

# Generate with:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Keep this key stable and back it up securely; losing it makes saved Lumen
# credentials unreadable. Store it in your deployment secret manager.
LUMEN_CREDENTIALS_ENCRYPTION_KEY=

ADMIN_DASHBOARD_EMAIL=2025em1300265@bitspilani-digital.edu.in
FIREBASE_PROJECT_ID=bits-dsai-tracker

# Optional comma-separated exact HTTPS origins. Do not use '*' or 'null'.
CORS_ORIGINS=
