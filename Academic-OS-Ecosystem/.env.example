# Set to production on any deployed environment (enables startup config checks)
APP_ENV=production

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/placement_db
# Or for SQLite (local dev): sqlite:///./placement.db

# Lumen (Brightspace) OAuth2 - REQUIRED for LMS sync
# Register app at BITS IT to get these credentials
LUMEN_CLIENT_ID=your_client_id_here
LUMEN_CLIENT_SECRET=your_client_secret_here
LUMEN_BASE_URL=https://lumen.bitspilani-digital.edu.in
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LUMEN_CREDENTIALS_ENCRYPTION_KEY=your_32_byte_fernet_key_here
LUMEN_REDIRECT_URI=https://your-domain.com/api/lumen/callback
LUMEN_CREDENTIALS_PATH=/app/runtime/lumen_credentials.json

# CORS - comma-separated origins
CORS_ORIGINS=https://your-frontend-domain.com,http://localhost:5500

# Firebase Admin (for backend token verification)
FIREBASE_PROJECT_ID=bits-dsai-tracker
# FIREBASE_SERVICE_ACCOUNT_KEY_PATH=/path/to/service-account.json
# Or set GOOGLE_APPLICATION_CREDENTIALS env var

# Admin dashboard access: the ONE verified Firebase account allowed to view all student data
ADMIN_DASHBOARD_EMAIL=2025em1300265@bitspilani-digital.edu.in

# Frontend URL (for OAuth redirects). For the Chrome extension use its page URL,
# e.g. chrome-extension://<extension-id>/index.html
FRONTEND_URL=https://your-frontend-domain.com

# Chrome extension origins allowed to call the API (exact chrome-extension://<32 chars a-p> form)
CHROME_EXTENSION_ORIGINS=

