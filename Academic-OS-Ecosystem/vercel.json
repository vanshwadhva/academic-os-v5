{
  "buildCommand": "pip install -r requirements.txt",
  "devCommand": "uvicorn backend.main:app --reload --port 8000",
  "installCommand": "pip install -r requirements.txt",
  "framework": null,
  "regions": ["iad1"],
  "functions": {
    "backend/main.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/backend/main.py"
    }
  ],
  "env": {
    "PYTHONPATH": "."
  }
}