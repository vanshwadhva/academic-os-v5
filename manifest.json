{
  "manifest_version": 3,
  "name": "Academic OS – Lumen Sync",
  "version": "2.2.4",
  "description": "Pulls your BITS Pilani Lumen grades, assignments, and module progress into an Academic OS dashboard.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": [
    "https://bits-dsai-tracker.web.app/*",
    "http://127.0.0.1:5500/*",
    "http://localhost:5500/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://lumen.bitspilani-digital.edu.in/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://bits-dsai-tracker.web.app/*",
        "http://127.0.0.1:5500/*",
        "http://localhost:5500/*"
      ],
      "js": ["config.js", "utils/logger.js", "content_scripts/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://lumen.bitspilani-digital.edu.in/*"],
      "js": [
        "config.js",
        "utils/logger.js",
        "network/network_monitor.js",
        "network/active_fetcher.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["https://lumen.bitspilani-digital.edu.in/*"],
      "js": ["network/lumen_token_bridge.js", "network/injected_hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
